var params := {}
## Личные настройки игрока — переживают смену версии баланса
const KEEP := ["master_db", "music_db", "sfx_db", "engine_db", "ui_db", "scheme", "render3d", "sprites", "damage_numbers",
	"shake_mult", "range_rings", "camera_zoom", "plane_len", "cam_tilt"]


func _ready() -> void:
	reset()
	load_params()
	_cmdline_params()


## Bench and comparison runs: --tune=key:value,key2:value2 sets parameters for this run only (not saved),
## before any scene reads them (Render3D reads ground_depth once, in _ready)
func _cmdline_params() -> void:
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--tune="):
			for kv in a.substr(7).split(","):
				var f := kv.split(":")
				if f.size() == 2 and params.has(f[0]):
					params[f[0]] = float(f[1])


func reset() -> void:
	for k in RANGES:
		params[k] = float(RANGES[k][3])


func g(key: String) -> float:
	return params[key]


func set_param(key: String, value: float) -> void:
	params[key] = float(value)


func save_params() -> void:
	var f := FileAccess.open(PATH, FileAccess.WRITE)
	if f:
		var data := params.duplicate()
		data["_version"] = VERSION
		f.store_string(JSON.stringify(data, "  "))
		f.close()


func load_params() -> void:
	if not FileAccess.file_exists(PATH):
		return
	var f := FileAccess.open(PATH, FileAccess.READ)
	if f == null:
		return
	var data = JSON.parse_string(f.get_as_text())
	f.close()
	if data is Dictionary:
		if int(data.get("_version", 0)) != VERSION:
			# сохранение от старой версии: баланс — новые стандартные значения,
			# а личные настройки (громкость, управление, картинка) сохраняем
			for k in KEEP:
				if data.has(k) and params.has(k):
					params[k] = float(data[k])
			return
		for k in data:
			if params.has(k):
				params[k] = float(data[k])
