msgstr "Homing missiles at priority targets"

#: game/scripts/weapons.gd:23
#, c-format
msgid "1 ракета с точки; ур. 2–5: +30% урона, −10% перезарядки; ур. 4: ещё +80% урона и +20% скорости"
msgstr "1 missile per pylon; Lv. 2–5: +30% damage, −10% cooldown; Lv. 4: another +80% damage and +20% speed"

