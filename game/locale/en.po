msgid "Двигатель сбит: %d из 2 — «Крепость» теряет скорость"
msgstr "Engine destroyed: %d of 2 — the \"Fortress\" is slowing down"

#: game/scripts/fortress.gd:268
msgid "Командная турель сбита — эскорт больше не придёт"
msgstr "Command turret down — no more escorts"

#: game/scripts/fortress.gd:270
