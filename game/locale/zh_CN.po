msgstr "按僚机任务"

#: game/scripts/settings.gd:47
msgid "прикрывать меня"
msgstr "掩护我"

#: game/scripts/settings.gd:47 game/scripts/weapons.gd:13
msgid "крупные и асы"
msgstr "大型目标和王牌"

#: game/scripts/settings.gd:47 game/scripts/weapons.gd:14
