#: game/scripts/cards.gd:62
msgid "Двигатели ракет"
msgstr "导弹发动机"

#: game/scripts/cards.gd:63
msgid "Пусковое устройство"
msgstr "发射装置"

#: game/scripts/cards.gd:64
msgid "Радиостанция «Болтушка»"
msgstr "“话痨”电台"

#: game/scripts/cards.gd:65
msgid "Сборщик трофеев"
msgstr "战利品收集器"

#: game/scripts/cards.gd:66
msgid "Уклонение: тренировка"
msgstr "闪避：训练"

#: game/scripts/cards.gd:67
msgid "Форсаж: тренировка"
msgstr "加力：训练"

#: game/scripts/cards.gd:69
msgid "Ремонт в воздухе"
msgstr "空中维修"

#: game/scripts/cards.gd:95
#, c-format
msgid "\nЗаймёт последнее место модуля (%d из %d): дальше — только улучшения взятых"
msgstr "\n占用最后一个模块槽位（%d / %d）：之后只能升级已有模块"

#: game/scripts/cards.gd:96
#, c-format
msgid "\nЗаймёт место модуля %d из %d"
msgstr "\n占用模块槽位 %d / %d"

#: game/scripts/cards.gd:100 game/scripts/cards.gd:560
msgid "Новое оружие"
msgstr "新武器"

#: game/scripts/cards.gd:101 game/scripts/cards.gd:568
msgid "Оружие"
msgstr "武器"

#: game/scripts/cards.gd:109 game/scripts/cards.gd:673 game/scripts/terms.gd:28
msgid "Модернизация"
msgstr "改装"

#: game/scripts/cards.gd:110 game/scripts/cards.gd:802
msgid "Мастерство класса"
msgstr "机型精通"

#: game/scripts/cards.gd:125
msgid "Карусель"
msgstr "旋转木马"

#: game/scripts/cards.gd:126
#, c-format
msgid "Наводящаяся ракета, сбившая цель, сразу пускает новую в ближайшую (до 4 перепусков, каждый +20% урона)"
msgstr "击落目标的追踪导弹会立即向最近目标再发射一枚（最多 4 次，每次 +20% 伤害）"

#: game/scripts/cards.gd:127
msgid "сбитие → новая ракета"
msgstr "击落 → 新导弹"

#: game/scripts/cards.gd:128
msgid "Термобарика"
msgstr "温压弹"

#: game/scripts/cards.gd:129
msgid "Ракета залпа прилипает и через 0,5 с даёт объёмный взрыв 130 пикс. (урон ×1,5); соседние взрывы сливаются: до ×2"
msgstr "齐射火箭弹会粘附目标，0.5 秒后产生 130 像素温压爆炸（伤害 ×1.5）；相邻爆炸会合并：最高 ×2"

#: game/scripts/cards.gd:130
msgid "прилипающие ракеты, объёмный взрыв"
msgstr "粘附火箭弹，温压爆炸"

#: game/scripts/cards.gd:131
msgid "Огненный вал"
msgstr "火墙"

#: game/scripts/cards.gd:132
msgid "Каждый 3-й залп ракет — вал: три линии по 5 взрывов в 250 / 450 / 650 пикс. впереди (урон ×1,3)"
msgstr "每第 3 次火箭弹齐射为弹幕：前方 250 / 450 / 650 像素处三排各 5 次爆炸（伤害 ×1.3）"

#: game/scripts/cards.gd:133
msgid "каждый 3-й залп — три линии огня"
msgstr "每第 3 次齐射——三排火焰"

#: game/scripts/cards.gd:134
msgid "Ковровая дорожка"
msgstr "红毯"

#: game/scripts/cards.gd:135
msgid "Бомба разбрасывает 4 суббоеприпаса крестом и оставляет горящее пятно на 2,5 с (12 урона/с)"
msgstr "炸弹呈十字散布 4 枚子弹药，并留下燃烧区域 2.5 秒（12 伤害/秒）"

#: game/scripts/cards.gd:136
msgid "кресты взрывов и огонь"
msgstr "十字爆炸与火焰"

#: game/scripts/cards.gd:137
msgid "Цепная реакция"
msgstr "连锁反应"

#: game/scripts/cards.gd:138
#, c-format
