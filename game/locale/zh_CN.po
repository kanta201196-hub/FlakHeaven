msgstr "巡洋舰“守望者”"

#: game/scripts/warship.gd:15
msgid "«Левиафан»"
msgstr "“利维坦”"

#: game/scripts/warship.gd:18
msgid "Крейсер на позиции. Воздух — ваш."
msgstr "巡洋舰就位。天空归你们了。"

#: game/scripts/warship.gd:18
msgid "Всем башням: цель воздушная, огонь по готовности."
msgstr "各炮塔注意：空中目标，准备好就开火。"

#: game/scripts/warship.gd:18
msgid "Пролив наш. Сбейте его."
msgstr "海峡是我们的。击落他。"

#: game/scripts/warship.gd:19
msgid "Зенитчики, заградительный!"
msgstr "高炮组，拦阻射击！"

#: game/scripts/warship.gd:19
msgid "Пуск! Пуск!"
msgstr "发射！发射！"

#: game/scripts/warship.gd:19
msgid "Держать его в секторе!"
msgstr "把他控制在扇区内！"

#: game/scripts/warship.gd:20
msgid "Пробоина! Аварийные партии на палубу!"
msgstr "船体破损！损管队上甲板！"

#: game/scripts/warship.gd:20
msgid "Крен на борт… продолжать огонь!"
msgstr "船体倾斜…继续开火！"

#: game/scripts/warship.gd:20
msgid "Поднять вертолёт!"
msgstr "放出直升机！"

#: game/scripts/warship.gd:21
msgid "Корабль тонет! Все наверх!"
msgstr "船要沉了！全员上甲板！"

#: game/scripts/warship.gd:21
msgid "Пожар в погребах… покинуть корабль!"
msgstr "弹药库起火…弃舰！"

