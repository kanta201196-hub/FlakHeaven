msgstr "“虫眼”导引头"

#: game/scripts/cards.gd:57
msgid "Осколочная рубашка"
msgstr "破片套"

#: game/scripts/cards.gd:58
msgid "Сервоприводы"
msgstr "伺服机构"

#: game/scripts/cards.gd:59 game/scripts/profile.gd:28
