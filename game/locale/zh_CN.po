msgstr ""

#: game/scripts/background.gd:11 game/scripts/biome.gd:14
msgid "Нагорье Шахрисанг"
msgstr "沙赫里桑高地"

#: game/scripts/background.gd:12
msgid "ущелья, кишлаки, следы боёв"
msgstr "峡谷、村落、战火痕迹"

#: game/scripts/balance/rewards.gd:23
msgid "ЗА ПОЗИЦИЮ ПВО"
msgstr "防空阵地奖励"

#: game/scripts/balance/rewards.gd:25
msgid "ЗА КОЛОННУ"
msgstr "车队奖励"

#: game/scripts/balance/rewards.gd:27
msgid "ЗА АСА"
msgstr "王牌奖励"

#: game/scripts/balance/rewards.gd:29
msgid "ЗА ГРУЗ ТРАНСПОРТА"
msgstr "运输机货物"

#: game/scripts/balance/rewards.gd:31
msgid "ЗА СПАСЁННОГО ПИЛОТА"
msgstr "营救飞行员"

#: game/scripts/balance/rewards.gd:33
msgid "ЗА ЗАДАНИЕ КЛАССА"
msgstr "完成机型任务"

#: game/scripts/biome.gd:24 game/scripts/hud_result.gd:390
msgid "Архипелаг Таласора"
msgstr "塔拉索拉群岛"

#: game/scripts/bomber.gd:26
msgid "бомбардировщики"
msgstr "轰炸机"

#: game/scripts/bomber.gd:58
msgid "Синяя дуга у носа бомбардировщика — лобовая броня: спереди урон вдвое меньше. Сзади бьёт турель (красный сектор). Заходите сбоку."
msgstr "轰炸机机头的蓝色线是正面装甲：从前方伤害减半。后方有炮塔（红色扇区）。从侧面进攻。"

#: game/scripts/boss.gd:15
msgid "Вижу цель. Работаем."
msgstr "目标确认。开工。"

#: game/scripts/boss.gd:15
msgid "Ты в моём небе, новичок."
msgstr "新手，你闯进了我的天空。"

#: game/scripts/boss.gd:15
msgid "Звено, не мешать — этот мой."
msgstr "编队别插手——这个归我。"

#: game/scripts/boss.gd:16
msgid "Захожу!"
msgstr "我进去了！"

#: game/scripts/boss.gd:16
msgid "Держись, сейчас прошью!"
msgstr "别动，看我打穿你！"

#: game/scripts/boss.gd:16
msgid "Атакую!"
msgstr "攻击！"

#: game/scripts/boss.gd:17
msgid "Ах ты… Ну держись!"
msgstr "你这家伙……等着瞧！"

#: game/scripts/boss.gd:17
msgid "Повреждения! Злее будем."
msgstr "受损了！我更火大了。"

#: game/scripts/boss.gd:17
msgid "Теперь без шуток."
msgstr "不开玩笑了。"

#: game/scripts/boss.gd:18
msgid "Подбит! Катапультируюсь!"
msgstr "被击中！弹射跳伞！"

#: game/scripts/boss.gd:18
msgid "Горю… выхожу из боя!"
msgstr "起火了……脱离战斗！"

#: game/scripts/boss.gd:68
msgid "Ас «Почтальон»"
msgstr "王牌“邮差”"

#: game/scripts/boss.gd:68
msgid "Ас «Сквозняк»"
msgstr "王牌“穿堂风”"

#: game/scripts/boss.gd:70
msgid "Ас «Альбатрос»"
msgstr "王牌“信天翁”"

#: game/scripts/boss.gd:77 game/scripts/boss.gd:85 game/scripts/boss.gd:212 game/scripts/fortress.gd:98 game/scripts/projectiles.gd:945
msgid "асы"
msgstr "王牌"

#: game/scripts/boss.gd:103
msgid "Ас "
msgstr "王牌 "

