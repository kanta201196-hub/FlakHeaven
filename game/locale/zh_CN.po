#: game/scripts/aa_site.gd:131
msgid "Позиция ПВО обнаружила вас! 60 с на уничтожение"
msgstr "防空阵地发现了你！60 秒内摧毁它"

#: game/scripts/aa_site.gd:137
msgid "Позиция ПВО устояла — награды не будет"
msgstr "防空阵地未被摧毁——没有奖励"

#: game/scripts/background.gd:11 game/scripts/biome.gd:14
msgid "Нагорье Шахрисанг"
msgstr "沙赫里桑高地"

#: game/scripts/background.gd:12
msgid "ущелья, кишлаки, следы боёв"
msgstr "峡谷、村落、战火痕迹"

#: game/scripts/biome.gd:24
msgid "Архипелаг Таласора"
msgstr "塔拉索拉群岛"

#: game/scripts/boss.gd:15
msgid "Вижу цель. Работаем."
msgstr "目标确认。开工。"

#: game/scripts/boss.gd:15
msgid "Ты в моём небе, новичок."
msgstr "新手，你闯进了我的天空。"

#: game/scripts/boss.gd:15
msgid "Звено, не мешать — этот мой."
msgstr "编队别插手——这个归我。"

#: game/scripts/boss.gd:16
msgid "Захожу!"
msgstr "我进去了！"

#: game/scripts/boss.gd:16
msgid "Держись, сейчас прошью!"
msgstr "别动，看我打穿你！"

#: game/scripts/boss.gd:16
msgid "Атакую!"
msgstr "攻击！"

#: game/scripts/boss.gd:17
msgid "Ах ты… Ну держись!"
msgstr "你这家伙……等着瞧！"

#: game/scripts/boss.gd:17
msgid "Повреждения! Злее будем."
msgstr "受损了！我更火大了。"

#: game/scripts/boss.gd:17
msgid "Теперь без шуток."
msgstr "不开玩笑了。"

#: game/scripts/boss.gd:18
msgid "Подбит! Катапультируюсь!"
msgstr "被击中！弹射跳伞！"

#: game/scripts/boss.gd:18
msgid "Горю… выхожу из боя!"
msgstr "起火了……脱离战斗！"

#: game/scripts/boss.gd:66
msgid "Ас «Почтальон»"
msgstr "王牌“邮差”"

#: game/scripts/boss.gd:66
msgid "Ас «Сквозняк»"
msgstr "王牌“穿堂风”"

#: game/scripts/boss.gd:68
msgid "Ас «Альбатрос»"
msgstr "王牌“信天翁”"

#: game/scripts/boss.gd:79 game/scripts/fortress.gd:92 game/scripts/hud_screens.gd:451 game/scripts/hud_screens.gd:473 game/scripts/render3d.gd:1686
msgid "асы"
msgstr "王牌"

#: game/scripts/boss.gd:92
msgid "Ас "
msgstr "王牌 "

#: game/scripts/boss.gd:111 game/scripts/run_log.gd:10
msgid "щит аса"
msgstr "王牌护盾"

#: game/scripts/campaign.gd:12
msgid "Учебный"
msgstr "训练"

#: game/scripts/campaign.gd:13
msgid "Боевой"
msgstr "战斗"

#: game/scripts/campaign.gd:14
msgid "Тяжёлый"
msgstr "困难"

#: game/scripts/campaign.gd:15
msgid "Ас"
msgstr "王牌"

#: game/scripts/campaign.gd:20
msgid "Перевал"
msgstr "山口"

#: game/scripts/campaign.gd:21
msgid "Колонна снабжения идёт через перевал Шахрисанг. Держите небо над дорогой 15 минут, потом уходите на базу через ворота эвакуации."
msgstr "补给车队正穿越沙赫里桑山口。守住道路上空 15 分钟，然后经撤离门返回基地。"

#: game/scripts/campaign.gd:22 game/scripts/campaign.gd:43
msgid "Продержаться до 15:00 и улететь через ворота"
msgstr "坚持到 15:00 并从撤离门飞离"

#: game/scripts/campaign.gd:23
msgid "колонна пройдёт через"
msgstr "车队通过还需"

#: game/scripts/campaign.gd:24
msgid "Операция 2 «Сухое русло»"
msgstr "作战 2“干涸河床”"

#: game/scripts/campaign.gd:24
msgid "Покупка самолёта ур. 2 в ангаре: тяжёлый подвес и рельсотрон"
msgstr "在机库购买 Lv.2 飞机：重型挂架和电磁炮"

#: game/scripts/campaign.gd:25
msgid "Сухое русло"
msgstr "干涸河床"

#: game/scripts/campaign.gd:26
msgid "Противник ставит ПВО в руслах рек. К 15-й минуте подойдёт «Крепость» — тяжёлый самолёт-штаб. Разведка видела аса с позывным «Барон»."
msgstr "敌军在河床中部署防空。第 15 分钟“堡垒”将抵达——一架重型指挥机。侦察发现一名呼号“男爵”的王牌。"

#: game/scripts/campaign.gd:27
msgid "Сбить «Крепость» (появится в 15:00) и улететь"
msgstr "击落“堡垒”（15:00 出现）并飞离"

#: game/scripts/campaign.gd:28 game/scripts/campaign.gd:33 game/scripts/campaign.gd:38
msgid "«Крепость» через"
msgstr "“堡垒”抵达还需"

#: game/scripts/campaign.gd:29
msgid "Операция 3 «Крепости»"
msgstr "作战 3“要塞”"

#: game/scripts/campaign.gd:29
msgid "ЭМИ-заряд для тяжёлого подвеса"
msgstr "重型挂架用电磁脉冲弹"

#: game/scripts/campaign.gd:29
msgid "Ступень 3 веток оружия для самолёта ур. 2 (готовится)"
msgstr "Lv.2 飞机的第 3 阶武器分支（筹备中）"

#: game/scripts/campaign.gd:30
msgid "Крепости"
msgstr "要塞"

#: game/scripts/campaign.gd:31
msgid "Старые горные крепости стали опорными пунктами. «Барон» ищет вас лично: примите дуэль и не дайте ему уйти. В 15:00 — снова «Крепость»."
msgstr "古老的山地要塞已成为敌军据点。“男爵”正亲自追猎你：接受决斗，别让他逃走。15:00——“堡垒”再次出现。"

#: game/scripts/campaign.gd:32
msgid "Сбить «Барона» в дуэли и «Крепость», затем улететь"
msgstr "在决斗中击落“男爵”和“堡垒”，然后飞离"

#: game/scripts/campaign.gd:34
msgid "Операция 4 «Небо над Шахрисангом»"
msgstr "作战 4“沙赫里桑上空”"

#: game/scripts/campaign.gd:34
msgid "Лазер «Луч» и плазменная бомба для тяжёлого подвеса"
msgstr "重型挂架用“光束”激光和等离子炸弹"

#: game/scripts/campaign.gd:35
msgid "Небо над Шахрисангом"
msgstr "沙赫里桑上空"

#: game/scripts/campaign.gd:36
msgid "Последний рывок: всё, что осталось у противника, поднято в воздух. Сбейте «Крепость» и возвращайтесь."
msgstr "最后冲刺：敌人剩下的一切都已升空。击落“堡垒”后返航。"

#: game/scripts/campaign.gd:37
msgid "Сбить «Крепость» на сложности «Ас» и улететь"
msgstr "在“王牌”难度下击落“堡垒”并飞离"

#: game/scripts/campaign.gd:39
msgid "Второй биом (готовится)"
msgstr "第二个地区（筹备中）"

#: game/scripts/campaign.gd:41
msgid "Пролив"
msgstr "海峡"

#: game/scripts/campaign.gd:42
msgid "Морской конвой противника идёт проливом между островами Таласоры. Береговые батареи и катера ПВО прикрывают фарватер. Держите небо 15 минут и уходите через ворота эвакуации."
msgstr "敌方海上车队正穿过塔拉索拉群岛间的海峡。岸防炮台和防空艇掩护着航道。守住天空 15 分钟，然后经撤离门离开。"

#: game/scripts/campaign.gd:44
msgid "конвой пройдёт пролив через"
msgstr "车队通过海峡还需"

#: game/scripts/campaign.gd:45
msgid "Операция «Маяк»"
msgstr "作战“灯塔”"

#: game/scripts/campaign.gd:46 game/scripts/profile.gd:65 game/scripts/profile.gd:71 game/scripts/profile.gd:85
msgid "Маяк"
msgstr "灯塔"

#: game/scripts/campaign.gd:47
msgid "На мысах у входа в бухты противник поставил посты наблюдения и батареи. Над водой ходят экранопланы «Крачка». Продержитесь до 15:00."
msgstr "敌军在海湾入口的海角上设置了观察哨和炮台。“燕鸥”地效飞行器掠过水面。坚持到 15:00。"

#: game/scripts/campaign.gd:48 game/scripts/campaign.gd:53
msgid "Продержаться до 15:00 и улететь"
msgstr "坚持到 15:00 并飞离"

#: game/scripts/campaign.gd:49 game/scripts/campaign.gd:54 game/scripts/campaign.gd:59
msgid "до эвакуации"
msgstr "距撤离还有"

#: game/scripts/campaign.gd:50
msgid "Операция «Затонувший порт»"
msgstr "作战“沉没港口”"

#: game/scripts/campaign.gd:51
msgid "Затонувший порт"
msgstr "沉没港口"

#: game/scripts/campaign.gd:52
msgid "Порт в глубине залива — склад и ремонтная база флота противника. Его прикрывает крейсер «Сторож». Продержитесь до 15:00."
msgstr "海湾深处的港口——敌方舰队的仓库和维修基地，由巡洋舰“守望者”守卫。坚持到 15:00。"

#: game/scripts/campaign.gd:55
msgid "Операция «Левиафан»"
msgstr "作战“利维坦”"

#: game/scripts/campaign.gd:56
msgid "Левиафан"
msgstr "利维坦"

#: game/scripts/campaign.gd:57
msgid "В открытом море — «Левиафан», корабль-носитель противника. Всё, что у него есть, поднято в воздух."
msgstr "公海上——敌方母舰“利维坦”。它的一切都已升空。"

#: game/scripts/campaign.gd:58
msgid "Продержаться до 15:00 на сложности «Ас» и улететь"
msgstr "在“王牌”难度下坚持到 15:00 并飞离"

#: game/scripts/campaign.gd:63
msgid "продержаться до 15:00"
msgstr "坚持到 15:00"

#: game/scripts/campaign.gd:63
msgid "сбить «Крепость»"
msgstr "击落“堡垒”"

#: game/scripts/campaign.gd:63
msgid "сбить «Барона» в дуэли"
msgstr "在决斗中击落“男爵”"

#: game/scripts/card_icons.gd:23 game/scripts/cards.gd:53 game/scripts/cards.gd:54 game/scripts/cards.gd:76 game/scripts/hud_codex.gd:238 game/scripts/hud_screens.gd:41
msgid "Пушка"
msgstr "机炮"

#: game/scripts/card_icons.gd:25 game/scripts/cards.gd:64 game/scripts/cards.gd:80 game/scripts/cards.gd:529 game/scripts/cards.gd:535 game/scripts/main_input.gd:332
msgid "Звено"
msgstr "编队"

#: game/scripts/card_icons.gd:27 game/scripts/cards.gd:66 game/scripts/cards.gd:67 game/scripts/cards.gd:68 game/scripts/cards.gd:78
msgid "Навык"
msgstr "技能"

#: game/scripts/card_icons.gd:29 game/scripts/cards.gd:81 game/scripts/cards.gd:680
msgid "Связка"
msgstr "羁绊"

#: game/scripts/card_icons.gd:31 game/scripts/cards.gd:84 game/scripts/cards.gd:551 game/scripts/cards.gd:552 game/scripts/cards.gd:553 game/scripts/cards.gd:555
msgid "Резерв"
msgstr "预备"

#: game/scripts/card_icons.gd:31 game/scripts/cards.gd:69 game/scripts/cards.gd:79
msgid "Ремонт"
msgstr "维修"

