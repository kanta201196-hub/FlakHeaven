msgstr "史诗"

#: game/scripts/cards.gd:13
msgid "Легендарная"
msgstr "传说"

#: game/scripts/cards.gd:50
msgid "Бронеплиты"
msgstr "装甲板"

#: game/scripts/cards.gd:50 game/scripts/cards.gd:51 game/scripts/cards.gd:52 game/scripts/cards.gd:65 game/scripts/cards.gd:75
msgid "Модуль"
msgstr "模块"

#: game/scripts/cards.gd:51
msgid "Форсированный двигатель"
msgstr "强化引擎"

#: game/scripts/cards.gd:52
msgid "Механизация крыла"
msgstr "襟翼"

#: game/scripts/cards.gd:53
msgid "Бронебойные снаряды"
msgstr "穿甲弹"

#: game/scripts/cards.gd:54
msgid "Облегчённый затвор"
msgstr "轻量化枪机"

#: game/scripts/cards.gd:55 game/scripts/profile.gd:29 game/scripts/profile.gd:31 game/scripts/profile.gd:37
msgid "Быстрая перезарядка"
msgstr "快速装填"

#: game/scripts/cards.gd:55 game/scripts/cards.gd:56 game/scripts/cards.gd:57 game/scripts/cards.gd:58 game/scripts/cards.gd:59 game/scripts/cards.gd:61
msgid "Подвесы"
msgstr "挂架"

#: game/scripts/cards.gd:56
msgid "Головка наведения «Глазастик»"
msgstr "“虫眼”导引头"

#: game/scripts/cards.gd:57
msgid "Осколочная рубашка"
msgstr "破片套"

#: game/scripts/cards.gd:58
msgid "Сервоприводы"
msgstr "伺服机构"

#: game/scripts/cards.gd:59 game/scripts/profile.gd:28
msgid "Усиленная боевая часть"
msgstr "强化战斗部"

#: game/scripts/cards.gd:61
msgid "Боевая часть"
msgstr "战斗部"

#: game/scripts/cards.gd:62
msgid "Двигатели ракет"
msgstr "导弹发动机"

#: game/scripts/cards.gd:63
msgid "Пусковое устройство"
msgstr "发射装置"

#: game/scripts/cards.gd:64
msgid "Радиостанция «Болтушка»"
msgstr "“话痨”电台"

#: game/scripts/cards.gd:65
msgid "Сборщик трофеев"
msgstr "战利品收集器"

#: game/scripts/cards.gd:66
msgid "Уклонение: тренировка"
msgstr "闪避：训练"

#: game/scripts/cards.gd:67
msgid "Форсаж: тренировка"
msgstr "加力：训练"

#: game/scripts/cards.gd:69
msgid "Ремонт в воздухе"
msgstr "空中维修"

#: game/scripts/cards.gd:73 game/scripts/cards.gd:473
msgid "Новое оружие"
msgstr "新武器"

#: game/scripts/cards.gd:74 game/scripts/cards.gd:481
msgid "Оружие"
msgstr "武器"

#: game/scripts/cards.gd:82 game/scripts/cards.gd:573
msgid "Модернизация"
msgstr "改装"

#: game/scripts/cards.gd:83 game/scripts/cards.gd:691
msgid "Мастерство класса"
msgstr "机型精通"

#: game/scripts/cards.gd:98
msgid "Карусель"
msgstr "旋转木马"

#: game/scripts/cards.gd:99
#, c-format
msgid "Наводящаяся ракета, сбившая цель, сразу пускает новую в ближайшую (до 4 перепусков, каждый +20% урона)"
msgstr "击落目标的追踪导弹会立即向最近目标再发射一枚（最多 4 次，每次 +20% 伤害）"

#: game/scripts/cards.gd:100
msgid "сбитие → новая ракета"
msgstr "击落 → 新导弹"

#: game/scripts/cards.gd:101
msgid "Термобарика"
msgstr "温压弹"

#: game/scripts/cards.gd:102
msgid "Ракета залпа прилипает и через 0,5 с даёт объёмный взрыв 130 пикс. (урон ×1,5); соседние взрывы сливаются: до ×2"
msgstr "齐射火箭弹会粘附目标，0.5 秒后产生 130 像素温压爆炸（伤害 ×1.5）；相邻爆炸会合并：最高 ×2"

#: game/scripts/cards.gd:103
msgid "прилипающие ракеты, объёмный взрыв"
msgstr "粘附火箭弹，温压爆炸"

#: game/scripts/cards.gd:104
msgid "Огненный вал"
msgstr "火墙"

#: game/scripts/cards.gd:105
msgid "Каждый 3-й залп ракет — вал: три линии по 5 взрывов в 250 / 450 / 650 пикс. впереди (урон ×1,3)"
msgstr "每第 3 次火箭弹齐射为弹幕：前方 250 / 450 / 650 像素处三排各 5 次爆炸（伤害 ×1.3）"

#: game/scripts/cards.gd:106
msgid "каждый 3-й залп — три линии огня"
msgstr "每第 3 次齐射——三排火焰"

#: game/scripts/cards.gd:107
msgid "Ковровая дорожка"
msgstr "红毯"

#: game/scripts/cards.gd:108
msgid "Бомба разбрасывает 4 суббоеприпаса крестом и оставляет горящее пятно на 2,5 с (12 урона/с)"
msgstr "炸弹呈十字散布 4 枚子弹药，并留下燃烧区域 2.5 秒（12 伤害/秒）"

#: game/scripts/cards.gd:109
msgid "кресты взрывов и огонь"
msgstr "十字爆炸与火焰"

#: game/scripts/cards.gd:110
msgid "Цепная реакция"
msgstr "连锁反应"

#: game/scripts/cards.gd:111
#, c-format
msgid "Враг, убитый взрывом ракеты залпа или бомбы, взрывается сам: 30 урона + 8% его прочности, радиус 90; цепь до 3 звеньев"
msgstr "被齐射火箭弹或炸弹爆炸击杀的敌人也会爆炸：30 伤害 + 其耐久的 8%，半径 90；最多连锁 3 次"

#: game/scripts/cards.gd:112
msgid "убитые взрывом рвутся домино"
msgstr "爆炸击杀如多米诺般连爆"

#: game/scripts/cards.gd:113
msgid "Волчья стая"
msgstr "狼群"

#: game/scripts/cards.gd:114
msgid "Когда вы пускаете ракеты, каждый ведомый дублирует пуск: 2 ракеты в вашу цель (×0,6 урона)"
msgstr "你发射导弹时，每架僚机同步发射：向你的目标发射 2 枚导弹（×0.6 伤害）"

#: game/scripts/cards.gd:115
msgid "звено повторяет ваши пуски"
msgstr "编队重复你的发射"

#: game/scripts/cards.gd:116
msgid "Тёплая компания"
msgstr "热情款待"

#: game/scripts/cards.gd:117
msgid "Раз в 7 с звено выходит вперёд и стелет ряд из 5 бомб поперёк пути самолёта (45 урона, 100 пикс.)"
msgstr "编队每 7 秒前出，在你的航线上横向投下一排 5 枚炸弹（45 伤害，100 像素）"

#: game/scripts/cards.gd:118
msgid "звено стелет огонь впереди"
msgstr "编队在前方铺设火焰"

#: game/scripts/cards.gd:119
msgid "Зеркало"
msgstr "镜像"

#: game/scripts/cards.gd:120
msgid "Уведённая ловушкой ракета разворачивается и бьёт ближайшего врага (80 урона, взрыв 90); уклонение отстреливает 6 ловушек"
msgstr "被干扰弹诱偏的导弹会掉头攻击最近的敌人（80 伤害，爆炸 90）；闪避时释放 6 枚干扰弹"

#: game/scripts/cards.gd:121
msgid "вражеские ракеты летят в своих"
msgstr "敌方导弹打向自己人"

#: game/scripts/cards.gd:122
msgid "Стальной ёж"
msgstr "钢铁刺猬"

#: game/scripts/cards.gd:123
#, c-format
msgid "Раз в 5 с каждая турель выпускает 3 мини-ракеты по разным целям (22, взрыв 45); турели раз в 3 с стреляют по ракете (сбивают в 55%)"
msgstr "每 5 秒每座炮塔向不同目标发射 3 枚微型导弹（22，爆炸 45）；炮塔每 3 秒射击一枚导弹（55% 命中）"

#: game/scripts/cards.gd:124
msgid "залп мини-ракет из турелей"
msgstr "炮塔微型导弹齐射"

#: game/scripts/cards.gd:125
msgid "Пушкарь"
msgstr "炮手"

#: game/scripts/cards.gd:126
msgid "Каждый 6-й снаряд гондолы — фугасный (урон ×4, взрыв 70); все пули гондолы пробивают 1 цель"
msgstr "机炮吊舱每第 6 发为高爆弹（伤害 ×4，爆炸 70）；机炮吊舱所有子弹穿透 1 个目标"

#: game/scripts/cards.gd:127
msgid "фугасные снаряды гондолы"
msgstr "机炮吊舱高爆弹"

#: game/scripts/cards.gd:128
msgid "Каток"
msgstr "压路机"

#: game/scripts/cards.gd:129
