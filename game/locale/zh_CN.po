#: game/scripts/hud_codex.gd:106
msgid "Мышь — куда лететь, W / S — газ"
msgstr "鼠标 — 飞行方向，W / S — 油门"

#: game/scripts/hud_codex.gd:107
#, c-format
msgid "Пушка стреляет сама; Q — ручной огонь левой кнопкой мыши (до +50% урона)"
msgstr "机炮自动射击；Q — 用鼠标左键手动射击（伤害最多 +50%）"

#: game/scripts/hud_codex.gd:108
msgid "Ракеты и бомбы пускаются сами; правая кнопка мыши — пуск вручную"
msgstr "导弹和炸弹自动发射；鼠标右键 — 手动发射"

#: game/scripts/hud_codex.gd:109
msgid "Space — уклонение (переворот, пули не попадают)"
msgstr "Space — 闪避（翻滚，子弹无法命中）"

#: game/scripts/hud_codex.gd:110
msgid "Shift — форсаж, E / F — навыки самолёта"
msgstr "Shift — 加力，E / F — 飞机技能"

#: game/scripts/hud_codex.gd:111
msgid "Tab — оружие на подвесах и пауза"
msgstr "Tab — 挂架武器与暂停"

#: game/scripts/hud_codex.gd:112
msgid "F2 — сменить управление"
msgstr "F2 — 切换操作方式"

#: game/scripts/hud_codex.gd:113
msgid "Геймпад: стик (сначала F2), курки — огонь, A — уклонение, X / B — навыки; главное меню — крестовиной и A, ангар — мышью"
msgstr "手柄：摇杆（先按F2），扳机开火，A闪避，X / B技能；主菜单用十字键和A，机库用鼠标"

#: game/scripts/hud_codex.gd:115 game/scripts/menu_main.gd:11
msgid "ВЫЛЕТ"
msgstr "出击"

#: game/scripts/hud_codex.gd:116
msgid "Цель — продержаться 15 минут и улететь через ворота эвакуации"
msgstr "目标——坚持 15 分钟并穿过撤离门离开"

#: game/scripts/hud_codex.gd:117
msgid "Всех врагов не перебить: они прилетают всё время"
msgstr "敌人杀不完：他们会源源不断地来"

#: game/scripts/hud_codex.gd:118
msgid "Сбитые враги дают опыт; новый уровень — выбор 1 из 3 улучшений"
msgstr "击落敌人获得经验；升级——从 3 个强化中选 1 个"

#: game/scripts/hud_codex.gd:119
msgid "Каждые 5 минут — вражеский ас, после него можно улететь"
msgstr "每 5 分钟出现一名敌方王牌，击落后即可离开"

#: game/scripts/hud_codex.gd:120
#, c-format
msgid "После 15:00 можно остаться: добыча +10% за каждую минуту"
msgstr "15:00 后可以留下：每分钟战利品 +10%"

#: game/scripts/hud_codex.gd:121
msgid "Погибли — часть запчастей сохраняется"
msgstr "阵亡——保留部分零件"

#: game/scripts/hud_codex.gd:123
msgid "ПРОКАЧКА"
msgstr "成长"

#: game/scripts/hud_codex.gd:124
msgid "На 3-м уровне выберите специализацию — какую связку собирать"
msgstr "3 级时选择专精——决定要凑哪种羁绊"

#: game/scripts/hud_codex.gd:125
msgid "Связка — сильный бонус; подходящие карточки отмечены «▲»"
msgstr "羁绊——强力加成；匹配的卡牌标有“▲”"

#: game/scripts/hud_codex.gd:126
msgid "За вылет — до 3 связок; список — в справочнике (меню и пауза)"
msgstr "每次出击最多 3 个羁绊；列表见图鉴（菜单和暂停）"

#: game/scripts/hud_codex.gd:127
msgid "Между вылетами — АНГАР: самолёт, оружие, экипаж"
msgstr "出击之间——机库：飞机、武器、机组"

#: game/scripts/hud_codex.gd:128
msgid "Экипаж растёт с каждым вылетом и открывает навыки"
msgstr "机组随每次出击成长并解锁技能"

#: game/scripts/hud_codex.gd:134
msgid "Позиция ПВО (голубая стрелка)"
msgstr "防空阵地（蓝色箭头）"

#: game/scripts/hud_codex.gd:134
msgid "Подлетите — пойдёт отсчёт. Разбейте бункер в центре, пока он не кончился; зенитки бьют издалека, заходите на скорости."
msgstr "靠近后开始倒计时。在倒计时结束前摧毁中央的掩体；高射炮射程远，要高速切入。"

#: game/scripts/hud_codex.gd:134 game/scripts/hud_flight.gd:674 game/scripts/hud_flight.gd:690
msgid "Награда: выбор из редких карточек + 40 запчастей"
msgstr "奖励：从稀有卡牌中选择 + 40 零件"

#: game/scripts/hud_codex.gd:135
msgid "Конвой (оранжевая стрелка)"
msgstr "车队（橙色箭头）"

#: game/scripts/hud_codex.gd:135
msgid "Колонна грузовиков идёт к укрытию. Подбейте головную машину — колонна встанет."
msgstr "卡车车队正驶向掩蔽处。击毁领头车辆——车队就会停下。"

#: game/scripts/hud_codex.gd:135
msgid "Награда: груз с каждого грузовика — запчасти и ремкомплекты"
msgstr "奖励：每辆卡车的货物——零件和维修包"

#: game/scripts/hud_codex.gd:136
msgid "Транспортник (розовая стрелка)"
msgstr "运输机（粉色箭头）"

#: game/scripts/hud_codex.gd:136
msgid "Пролетает район с прикрытием и уходит. Бейте сам транспортник, прикрытие только отвлекает."
msgstr "在护航下飞越该区域后离开。直接攻击运输机，护航只是干扰。"

#: game/scripts/hud_codex.gd:136 game/scripts/hud_flight.gd:707
msgid "Награда: груз — запчасти и ремкомплекты"
msgstr "奖励：货物——零件和维修包"

#: game/scripts/hud_codex.gd:137
msgid "Дуэль с асом (красная стрелка)"
msgstr "与王牌决斗（红色箭头）"

#: game/scripts/hud_codex.gd:137
msgid "Ас заходит в хвост. Сбросьте газ (S) или сделайте боевой разворот (E) — он проскочит под вашу пушку."
msgstr "王牌会咬住你的尾部。收油门（S）或战斗转弯（E）——他会冲到你的机炮前方。"

#: game/scripts/hud_codex.gd:137 game/scripts/hud_flight.gd:712
msgid "Награда: выбор из редких карточек"
msgstr "奖励：从稀有卡牌中选择"

#: game/scripts/hud_codex.gd:138
msgid "Ас каждые 5 минут"
msgstr "每 5 分钟出现王牌"

#: game/scripts/hud_codex.gd:138
msgid "Сильный враг с полосой прочности сверху. Собьёте — откроются ворота эвакуации и добавится переброс."
msgstr "带顶部耐久条的强敌。击落后撤离门开启，并获得一次重抽。"

#: game/scripts/hud_codex.gd:138
#, c-format
msgid "После 15:00 — добыча +10% за каждую минуту, пока не улетите"
msgstr "15:00 后——每多停留一分钟，战利品 +10%，直到离开"

#: game/scripts/hud_codex.gd:139 game/scripts/tanker.gd:235
msgid "Заправщик"
msgstr "加油机"

#: game/scripts/hud_codex.gd:139
msgid "Когда бак на исходе, прилетает свой заправщик. Зайдите ему в хвост и держитесь рядом."
msgstr "油箱快空时，友方加油机会飞来。咬住它的尾部并保持靠近。"

