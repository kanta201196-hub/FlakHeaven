msgid "Так себе"
msgstr "一般"

#: game/scripts/report.gd:30
msgid "Звук и музыка (1–5)"
msgstr "音效和音乐（1–5）"

#: game/scripts/report.gd:32
msgid "Как вам картинка? (1–5)"
msgstr "画面怎么样？（1–5）"

#: game/scripts/report.gd:33
msgid "Какой наклон камеры удобнее? (F9)"
msgstr "哪个镜头倾角更舒服？（F9）"

#: game/scripts/report.gd:33
msgid "Сверху"
msgstr "俯视"

#: game/scripts/report.gd:33
msgid "Не пробовал(а)"
msgstr "没试过"

#: game/scripts/report.gd:34
msgid "Пули и ракеты врагов видно?"
msgstr "能看清敌人的子弹和导弹吗？"

#: game/scripts/report.gd:34
msgid "Всегда"
msgstr "总是能"

#: game/scripts/report.gd:34
msgid "Иногда терялись"
msgstr "有时看丢"

#: game/scripts/report.gd:34
msgid "Часто терялись"
msgstr "经常看丢"

#: game/scripts/report.gd:35
msgid "Игра тормозила?"
msgstr "游戏卡顿吗？"

#: game/scripts/report.gd:35
msgid "Иногда"
msgstr "有时"

#: game/scripts/report.gd:35
msgid "Часто"
msgstr "经常"

#: game/scripts/report.gd:141
msgid "Что понравилось больше всего?"
msgstr "最喜欢什么？"

#: game/scripts/report.gd:141
msgid "Что было скучно или раздражало?"
msgstr "什么让你觉得无聊或烦躁？"

#: game/scripts/report.gd:142
msgid "Что было непонятно?"
msgstr "什么不清楚？"

#: game/scripts/report.gd:142
msgid "Баги, вылеты, тормоза, идеи и всё остальное"
msgstr "bug、崩溃、卡顿、想法及其他"

#: game/scripts/report.gd:162
msgid "Выйти без отчёта"
msgstr "不提交报告退出"

#: game/scripts/report.gd:242
msgid "можно оставить пустым"
msgstr "可以留空"

#: game/scripts/report.gd:288
msgid "ВЫХОД ИЗ ВЫЛЕТА"
msgstr "退出出击"

#: game/scripts/report.gd:289
msgid "Пара кнопок перед выходом очень поможет: почему закончили и как было. Можно выйти и без отчёта — строка статистики вылета всё равно уйдёт."
msgstr "退出前点几下会很有帮助：为什么结束、感觉如何。也可以不提交报告直接退出——出击统计仍会发送。"

#: game/scripts/report.gd:290
msgid "Вернуться в бой"
msgstr "返回战斗"

#: game/scripts/report.gd:291
msgid "ОТПРАВИТЬ И ВЫЙТИ"
msgstr "发送并退出"

#: game/scripts/report.gd:293
msgid "ОТЧЁТ ТЕСТЕРА"
msgstr "测试员报告"

#: game/scripts/report.gd:294
msgid "Уйдёт организатору теста: ваши ответы, статистика этого вылета, ОС и видеокарта, технический журнал игры. Личных данных нет. Отвечайте только на то, что хочется."
msgstr "将发送给测试组织者：你的回答、本次出击统计、操作系统和显卡、游戏技术日志。不含个人数据。只回答你想回答的。"

#: game/scripts/report.gd:295
msgid "Отмена"
msgstr "取消"

#: game/scripts/report.gd:296
msgid "ОТПРАВИТЬ"
msgstr "发送"

#: game/scripts/report.gd:307
msgid "закрыл игру"
msgstr "关闭了游戏"

#: game/scripts/report.gd:362
#, c-format
msgid "[Понравилось: %s]"
msgstr "[喜欢：%s]"

#: game/scripts/report.gd:508
msgid "Спасибо! Отчёт отправляется…"
msgstr "谢谢！正在发送报告…"

#: game/scripts/report.gd:513
msgid "Отправляем…"
msgstr "发送中…"

#: game/scripts/report.gd:529
#, c-format
msgid "не удалось начать отправку (%d)"
msgstr "无法开始发送（%d）"

#: game/scripts/report.gd:540
#, c-format
msgid "нет связи с сервером (код %d / %d)"
msgstr "无法连接服务器（代码 %d / %d）"

#: game/scripts/report.gd:552
msgid "Отправлено — спасибо!"
msgstr "已发送——谢谢！"

#: game/scripts/report.gd:560
#, c-format
msgid "Не отправилось: %s. Отчёт сохранён и уйдёт при следующей отправке или запуске игры."
msgstr "未发送：%s。报告已保存，将在下次发送或启动游戏时发出。"

#: game/scripts/rescue.gd:43
msgid "Слышу аварийный маяк! Наш пилот внизу — прикройте вертолёт."
msgstr "听到求救信标！我方飞行员在下面——掩护直升机。"

#: game/scripts/rescue.gd:44
msgid "Спасатель"
msgstr "救援队"

#: game/scripts/rescue.gd:44
msgid "Забираем! Держите небо ещё полминуты."
msgstr "正在接人！再守住天空半分钟。"

#: game/scripts/rescue.gd:45
msgid "Сбитый пилот: держите небо над маяком 30 с"
msgstr "坠机飞行员：在信标上空坚守 30 秒"

#: game/scripts/rescue.gd:76
msgid "Спасённый"
msgstr "获救飞行员"

#: game/scripts/rescue.gd:76
msgid "Спасибо, звено. Я видел парашют «Грома» — у старых крепостей."
msgstr "谢谢，编队。我看到了“雷霆”的降落伞——在旧要塞附近。"

#: game/scripts/rescue.gd:82
msgid "Вертолёт ушёл без пилота. Ищем дальше."
msgstr "直升机没接到飞行员就撤离了。继续搜索。"

#: game/scripts/rival_ace.gd:22
msgid "Шершень"
msgstr "大黄蜂"

#: game/scripts/rival_ace.gd:22
msgid "Граф"
msgstr "伯爵"

#: game/scripts/rival_ace.gd:22
msgid "Сокол-7"
msgstr "猎隼-7"

#: game/scripts/rival_ace.gd:22
msgid "Профессор"
msgstr "教授"

#: game/scripts/rival_ace.gd:22
msgid "Тётя Шура"
msgstr "舒拉姨"

#: game/scripts/rival_ace.gd:24
msgid "Ну здравствуй, новичок. Пристегнись."
msgstr "你好啊，新手。系好安全带。"

#: game/scripts/rival_ace.gd:24
msgid "Я тебя давно ищу. Потанцуем?"
msgstr "我找你很久了。跳支舞吧？"

#: game/scripts/rival_ace.gd:24
msgid "О, свежий самолёт. Будет что рассказать в столовой."
msgstr "哦，新飞机。食堂里有得聊了。"

#: game/scripts/rival_ace.gd:25
msgid "Вижу тебя. Ты у меня на мушке!"
msgstr "看见你了。你已经被我瞄准了！"

#: game/scripts/rival_ace.gd:25
msgid "Не верти хвостом — всё равно достану."
msgstr "别摇尾巴了——反正我会追上你。"

#: game/scripts/rival_ace.gd:25
msgid "Сиди смирно, сейчас будет больно."
msgstr "老实待着，接下来会很疼。"

#: game/scripts/rival_ace.gd:26
msgid "Эй! Тормозить — нечестно!"
msgstr "喂！减速可是作弊！"

#: game/scripts/rival_ace.gd:26
msgid "Проскочил… бывает."
msgstr "冲过头了…难免的。"

#: game/scripts/rival_ace.gd:26
msgid "Ладно, ладно, зайду ещё раз."
msgstr "好吧好吧，我再绕一圈。"

#: game/scripts/rival_ace.gd:27
msgid "Кто это у меня на хвосте?!"
msgstr "谁咬住了我的尾巴？！"

#: game/scripts/rival_ace.gd:27
msgid "Слезь с хвоста, я тебе не такси!"
msgstr "别咬着我尾巴，我又不是出租车！"

#: game/scripts/rival_ace.gd:27
msgid "Ведомый, помоги! А, у меня нет ведомого…"
msgstr "僚机，帮忙！啊，我没有僚机…"

#: game/scripts/rival_ace.gd:28
msgid "Ай! Это была новая краска!"
msgstr "哎！这可是新刷的漆！"

#: game/scripts/rival_ace.gd:28
msgid "Ну всё, теперь это личное."
msgstr "好了，现在是私人恩怨了。"

#: game/scripts/rival_ace.gd:29
msgid "Катапультируюсь! Увидимся в столовой…"
msgstr "弹射！食堂见…"

#: game/scripts/rival_ace.gd:29
msgid "Хорош… Признаю."
msgstr "厉害…我服了。"

#: game/scripts/rival_ace.gd:29
msgid "Передай механику — он был прав про двигатель."
msgstr "告诉机械师——他说发动机的事说对了。"

#: game/scripts/rival_ace.gd:30
msgid "Топливо на нуле. В другой раз, новичок!"
msgstr "燃油见底了。下次吧，新手！"

#: game/scripts/rival_ace.gd:30
msgid "Мне пора на обед. Не скучай!"
msgstr "我该去吃午饭了。别想我！"

#: game/scripts/rival_ace.gd:31
msgid "Снова ты? В прошлый раз тебе повезло."
msgstr "又是你？上次算你走运。"

#: game/scripts/rival_ace.gd:31
msgid "Узнаю этот самолёт. Сегодня без поблажек."
msgstr "我认得这架飞机。今天不留情。"

#: game/scripts/rival_ace.gd:31
msgid "Мы уже встречались. Второй раз не уйдёшь."
msgstr "我们见过面。这次你跑不掉了。"

#: game/scripts/rival_ace.gd:36 game/scripts/rival_ace.gd:37
msgid "Один на один. Без ваших нянек."
msgstr "一对一。别带保姆。"

#: game/scripts/rival_ace.gd:37
msgid "Снова вы? Неделю назад ваш «Гром» тоже был уверен в себе."
msgstr "又是你？一周前你们的“雷霆”也很自信。"

#: game/scripts/rival_ace.gd:38
msgid "…Неплохо. Для новичка."
msgstr "……不错。对新手来说。"

#: game/scripts/rival_ace.gd:82
msgid "ас-соперник"
msgstr "敌方王牌"

#: game/scripts/rival_ace.gd:218
msgid "Перелёт!"
msgstr "冲过头了！"

#: game/scripts/run_log.gd:10
msgid "ведомые"
msgstr "僚机"

