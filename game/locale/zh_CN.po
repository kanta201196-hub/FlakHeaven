msgid "Точка эвакуации"
msgstr ""

#: game/scripts/weapons.gd:10
msgid "ближайшие"
msgstr "最近"

#: game/scripts/weapons.gd:11
msgid "самые прочные"
msgstr "最耐打"

#: game/scripts/weapons.gd:12
msgid "добивать слабых"
msgstr "先打弱的"

#: game/scripts/weapons.gd:19
msgid "Ракеты «воздух-воздух»"
msgstr "空空导弹"

#: game/scripts/weapons.gd:20
msgid "Наводящиеся ракеты"
msgstr "追踪导弹"

#: game/scripts/weapons.gd:21
msgid "Самонаводящиеся ракеты по целям приоритета"
msgstr "追踪导弹攻击优先目标"

#: game/scripts/weapons.gd:23
#, c-format
msgid "1 ракета с точки; ур. 2–5: +30% урона, −10% перезарядки; ур. 4: ещё +80% урона и +20% скорости"
msgstr "每个挂点1枚导弹；Lv.2–5：伤害+30%，冷却−10%；Lv.4：伤害再+80%，速度+20%"

#: game/scripts/weapons.gd:26
msgid "Неуправляемые ракеты (залп)"
msgstr "无制导火箭弹（齐射）"

#: game/scripts/weapons.gd:27
msgid "Залп ракет"
msgstr "火箭弹齐射"

#: game/scripts/weapons.gd:28
msgid "Залп ракет вперёд, взрыв по площади, по наземным целям урон ×3. Пускаются сами, когда враг точно перед носом; в паузе (Tab) можно перевести на правую кнопку мыши"
msgstr "向前齐射火箭弹，范围爆炸，对地面目标伤害×3。敌人正对机头时自动发射；暂停时（Tab）可改为鼠标右键"

#: game/scripts/weapons.gd:30
#, c-format
msgid "залп — 4 ракеты с точки, ур. 3–4 — 5, ур. 5 — 6; ур. 2–5: +25% урона, +10% радиуса; по земле урон ×3"
msgstr "齐射——每个挂点4枚火箭弹，Lv.3–4为5枚，Lv.5为6枚；Lv.2–5：伤害+25%，半径+10%；对地伤害×3"

#: game/scripts/weapons.gd:33
msgid "Пушечная гондола"
msgstr "机炮吊舱"

#: game/scripts/weapons.gd:34
msgid "Гондола"
msgstr "吊舱"

#: game/scripts/weapons.gd:35
msgid "Поворотная пушка: сама наводится на цели приоритета вокруг самолёта"
msgstr "旋转机炮：自动瞄准飞机周围的优先目标"

#: game/scripts/weapons.gd:37
#, c-format
msgid "ур. 2–5: +25% урона, +10% темпа и дальности"
msgstr "Lv.2–5：伤害+25%，射速和射程+10%"

#: game/scripts/weapons.gd:40
msgid "Тепловые ловушки"
msgstr "热诱弹"

#: game/scripts/weapons.gd:42
msgid "Отстрел тепловых ловушек: ракета, подошедшая близко, уходит на вспышку и рвётся возле неё; с ур. 4 — две ракеты и пули рядом"
msgstr "投放干扰弹：靠近的导弹会追向闪光并在其附近爆炸；Lv.4起——两枚导弹及附近子弹"

#: game/scripts/weapons.gd:44
#, c-format
msgid "ур. 2–5: −10% перезарядки, +8% радиуса; ур. 4: две ракеты за раз и пули рядом"
msgstr "Lv.2–5：冷却−10%，半径+8%；Lv.4：一次两枚导弹及附近子弹"

#: game/scripts/weapons.gd:47
msgid "Кассетные бомбы"
msgstr "集束炸弹"

#: game/scripts/weapons.gd:48
msgid "Бомбы"
msgstr "炸弹"

#: game/scripts/weapons.gd:49
msgid "Бомбы по наземным целям: взрыв по площади, урон ×2 по земле; самолёты не задевают"
msgstr "攻击地面目标的炸弹：范围爆炸，对地伤害×2；不会击中飞机"

#: game/scripts/weapons.gd:51
#, c-format
msgid "ур. 2–5: +25% урона, +10% радиуса, −8% перезарядки"
msgstr "Lv.2–5：伤害+25%，半径+10%，冷却−8%"

#: game/scripts/weapons.gd:55
msgid "Рельсотрон (экспериментальный)"
msgstr "电磁炮（实验型）"

#: game/scripts/weapons.gd:56
msgid "Рельсотрон"
msgstr "电磁炮"

#: game/scripts/weapons.gd:57
msgid "Заряжается 0,9 с и бьёт по носу: снаряд пробивает всё на линии 1 200 пикс. Стреляет сам, когда враг впереди"
msgstr "充能0.9秒后向前射击：炮弹贯穿1 200像素直线上的一切。敌人在前方时自动开火"

#: game/scripts/weapons.gd:59
#, c-format
msgid "ур. 2–5: +30% урона, −8% перезарядки"
msgstr "Lv.2–5：伤害+30%，冷却−8%"

#: game/scripts/weapons.gd:62
msgid "ЭМИ-заряд (экспериментальный)"
msgstr "电磁脉冲弹（实验型）"

#: game/scripts/weapons.gd:64
msgid "Импульс вокруг самолёта: дронам — урон ×5, остальные враги и ПВО молчат 3 с (летят по инерции, не стреляют), вражеские ракеты теряют цель. По асам и «Крепости» — слабо"
msgstr "飞机周围的脉冲：对无人机伤害×5，其他敌人和防空沉默3秒（惯性飞行，不开火），敌方导弹丢失目标。对王牌和“堡垒”效果弱"

#: game/scripts/weapons.gd:66
#, c-format
msgid "ур. 2–5: +25% урона, +8% радиуса, −8% перезарядки"
msgstr "Lv.2–5：伤害+25%，半径+8%，冷却−8%"

#: game/scripts/weapons.gd:69
msgid "Лазер обороны «Луч» (экспериментальный)"
msgstr "“光束”防御激光（实验型）"

#: game/scripts/weapons.gd:70
msgid "Лазер «Луч»"
msgstr "“光束”激光"

#: game/scripts/weapons.gd:71
msgid "Сжигает вражеские ракеты и пули рядом с самолётом и подсвечивает ближайшего врага. По самолётам и земле — слабо"
msgstr "烧毁飞机附近的敌方导弹和子弹，并标记最近的敌人。对飞机和地面效果弱"

#: game/scripts/weapons.gd:73
#, c-format
msgid "ур. 2–5: +8% радиуса, −8% перезарядки, +25% урона"
msgstr "Lv.2–5：半径+8%，冷却−8%，伤害+25%"

#: game/scripts/weapons.gd:76
msgid "Плазменная бомба (экспериментальная)"
msgstr "等离子炸弹（实验型）"

#: game/scripts/weapons.gd:77
msgid "Плазма"
msgstr "等离子"

#: game/scripts/weapons.gd:78
msgid "Шар плазмы на земле 4 с: жжёт наземные цели и прожигает укрытия. Только по земле, долгая перезарядка"
msgstr "地面上持续4秒的等离子球：灼烧地面目标并烧穿掩体。仅限对地，冷却长"

#: game/scripts/weapons.gd:80
#, c-format
msgid "ур. 2–5: +25% урона в секунду, +8% радиуса, −8% перезарядки"
msgstr "Lv.2–5：每秒伤害+25%，半径+8%，冷却−8%"

#: game/scripts/weapons.gd:83
msgid "Автотурели"
msgstr "自动炮塔"

#: game/scripts/weapons.gd:85
msgid "Встроенные турели кругового обстрела"
msgstr "内置全向射击炮塔"

#: game/scripts/weapons.gd:87
#, c-format
msgid "ур. 2–5: +15% урона, +10% темпа"
msgstr "Lv.2–5：伤害+15%，射速+10%"

#: game/scripts/whats_new.gd:8
msgid "Первый босс «Крепость» проходим на любом самолёте и иначе ведёт себя с подбитыми двигателями"
msgstr "首个首领“堡垒”任何飞机都能击败，引擎受损后行为会改变"

#: game/scripts/whats_new.gd:9
msgid "Ведомые «Осы» и «Кита» присоединяются по ходу вылета и больше не врезаются в вас на вираже"
msgstr "“黄蜂”和“鲸”的僚机在出击中途加入，急转弯时不再撞上你"

#: game/scripts/whats_new.gd:10
msgid "Ас в догфайте больше не таранит игрока"
msgstr "缠斗中的王牌不再撞向玩家"

#: game/scripts/whats_new.gd:11
msgid "У самолётов ур. 1 и ур. 2 свои уровни, после 35-го уровня открывается мастерство оружия"
msgstr "1级和2级飞机分别升级；35级后解锁武器专精"

#: game/scripts/whats_new.gd:12
msgid "Вертолёт «Сарыч» стреляет ракетами с дымным следом, прицел бомб — метка на земле"
msgstr "“鵟鹰”直升机发射带烟迹的火箭弹；炸弹瞄准点显示为地面标记"

#: game/scripts/whats_new.gd:13
msgid "На экране вылета можно сменить навык класса и прочитать, что он делает"
msgstr "在出击界面可以更换职业技能并查看其效果"

#: game/scripts/whats_new.gd:14
msgid "Подсказки на карточках улучшений, новая панель паузы, крупнее радиоэфир"
msgstr "升级卡提示、新的暂停面板、更大的无线电面板"

#: game/scripts/wingman.gd:67
msgid "ведомые: "
msgstr "僚机： "

#: game/scripts/wingman.gd:92
msgid "Подбит, выхожу из боя! Замена через 20 секунд."
msgstr "我被击中，退出战斗！20 秒后替补。"

#: game/scripts/wingman.gd:93
msgid "Ведомый сбит. Держитесь, замена на подходе."
msgstr "僚机被击落。坚持住，替补正在赶来。"

#: game/scripts/wingman.gd:168
msgid "Иду к вам, займу место в строю!"
msgstr "正在赶来，加入编队！"

#: game/scripts/wingman.gd:436
msgid "связка: тёплая компания"
msgstr "羁绊：热闹伙伴"

#: game/scripts/wingman.gd:450
msgid "связка: волчья стая"
msgstr "羁绊：狼群"

#: game/scripts/gfx_presets.gd (UI-01 step 3)
msgid "«Весь экран» — тени до края кадра. «Ближе» — тени только у центра, зато они чётче."
msgstr "“全屏”：阴影延伸到画面边缘。“较近”：只在中央显示阴影，但更清晰。"

#: game/scripts/gfx_presets.gd (UI-01 step 3)
msgid "Билинейный"
msgstr "双线性"

#: game/scripts/gfx_presets.gd (UI-01 step 3)
msgid "Ближе"
msgstr "较近"

#: game/scripts/gfx_presets.gd (UI-01 step 3)
msgid "В каком разрешении рисуется 3D-картинка. Меньше — больше кадров, но картинка мягче. Интерфейс всегда чёткий."
msgstr "3D 画面的渲染分辨率。越低帧数越高，但画面更柔和。界面始终清晰。"

#: game/scripts/gfx_presets.gd (UI-01 step 3)
msgid "Весь экран"
msgstr "全屏"

