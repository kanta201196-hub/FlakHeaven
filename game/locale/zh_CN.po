#: game/scripts/settings.gd:27
msgid "Огонь: авто / ручной"
msgstr "开火：自动 / 手动"

#: game/scripts/settings.gd:28
msgid "Цель звена (ведомых)"
msgstr "编队目标（僚机）"

#: game/scripts/settings.gd:29
msgid "Огонь из пушки (клавиша)"
msgstr "机炮开火（按键）"

#: game/scripts/settings.gd:30
msgid "Ракеты залпом / бомбы: держать — прицел, отпустить — сброс"
msgstr "火箭弹齐射 / 炸弹：按住瞄准，松开投放"

#: game/scripts/settings.gd:31
msgid "Подвесы (пауза)"
msgstr "挂架（暂停）"

#: game/scripts/settings.gd:32
msgid "Перебросить карточки / заново"
msgstr "重抽卡牌 / 重新开始"

#: game/scripts/settings.gd:33
