msgstr "指示屏幕外的任务、撤离门和加油机；标签显示距离。"

#: game/scripts/hud_codex.gd:142
msgid "Цвет стрелки = цвет задания"
msgstr "箭头颜色 = 任务颜色"

#: game/scripts/hud_codex.gd:143
msgid "Серия сбитий"
msgstr "连杀"

#: game/scripts/hud_codex.gd:143
msgid "Сбивайте без перерыва — растёт множитель опыта (справа под счётом)."
msgstr "不间断击落敌机——经验倍率会提升（右侧，分数下方）。"

#: game/scripts/hud_codex.gd:143
msgid "Перерыв — серия сгорает"
msgstr "中断——连杀清零"

#: game/scripts/hud_codex.gd:153
msgid "‹ Назад (Esc)"
msgstr "‹ 返回（Esc）"

